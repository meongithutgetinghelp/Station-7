extends SceneTree
func _init() -> void: call_deferred("run")
func capture(file: String) -> void:
	await create_timer(0.6).timeout
	RenderingServer.force_draw()
	root.get_texture().get_image().save_png("res://builds/remaining-qa/"+file+".png")
	print("CAPTURED: ", file)
func run() -> void:
	root.mode = Window.MODE_WINDOWED
	var gm = root.get_node("GameManager")
	gm.new_campaign()
	gm.set_process(false)
	var station = load("res://station_builder.tscn").instantiate()
	root.add_child(station)
	current_scene = station
	gm.turn_on_power()
	gm.sign_in()
	var player = station.get_node("Player")
	player.set_physics_process(false)
	player.position = Vector3(5,0.36,-12)
	player.camera.look_at(Vector3(0,1.5,5))
	await create_timer(5.5).timeout
	station.get_node("NightEvents").begin_incident()
	await capture("compact-hud")
	station.get_node("StationJobs").open_journal()
	await capture("night-log")
	station.get_node("StationJobs").journal.close_panel()
	station.get_node("NightHUD").hide()
	player.hide()
	player.set_flashlight(false, false)
	var art_camera := Camera3D.new()
	station.add_child(art_camera)
	art_camera.current = true
	art_camera.position = Vector3(-5.4,1.8,-13.8)
	art_camera.look_at(Vector3(-5.4,1.9,-15.73))
	player.position = Vector3(-5.4,0.36,-13.8)
	player.camera.look_at(Vector3(-5.4,1.9,-15.73))
	await capture("service-poster")
	art_camera.position = Vector3(12.7,1.8,-9.8)
	art_camera.look_at(Vector3(15.73,2,-8.6))
	player.position = Vector3(12.7,0.36,-9.8)
	player.camera.look_at(Vector3(15.73,2,-8.6))
	await capture("wall-detail")
	art_camera.position = Vector3(3.8,1.75,10.8)
	art_camera.look_at(Vector3(3.8,1.75,12.08))
	player.position = Vector3(3.8,0.36,10.8)
	player.camera.look_at(Vector3(3.8,1.7,12.08))
	print("ART CAMERA: ", art_camera.global_position, " current ", art_camera.current, " real ", root.get_camera_3d().name)
	await capture("service-indicator")
	quit()
